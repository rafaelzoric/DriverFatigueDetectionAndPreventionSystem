/*
 * SleepAway — Wearable Headband Module
 * =====================================
 * ESP32-C3 + MPU6050 + vibration motor
 *
 * Streams calibrated IMU data to the Raspberry Pi 5 over Bluetooth Low
 * Energy, and drives the vibration motor when the Pi raises an alert.
 *
 * IMU data (headband -> Pi), notify characteristic:
 *   12 bytes, six signed 16-bit integers, little-endian
 *   [ax, ay, az, gx, gy, gz]
 *   Accelerometer scaled by 400, gyroscope scaled by 3000
 *
 * Vibration control (Pi -> headband), write characteristic:
 *   1 byte: 1 = vibrate, 0 = stop
 *   The Pi re-sends 1 every second while the alert is active. If no
 *   command arrives for VIBE_TIMEOUT_MS the motor switches itself off,
 *   so a crashed Pi or lost link can never leave it running.
 */

#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Wire.h>

#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

Adafruit_MPU6050 mpu;

// ── BLE identifiers — must match the Pi side exactly ──────────────
#define DEVICE_NAME         "SleepAway-Headband"
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"   // IMU data
#define VIBE_UUID           "beb5483f-36e1-4688-b7f5-ea07361b26a8"   // motor control

// ── Scaling factors for int16 packing ─────────────────────────────
#define ACCEL_SCALE 400.0f
#define GYRO_SCALE  3000.0f

// ── Timing ────────────────────────────────────────────────────────
#define SEND_INTERVAL_MS  50      // 20 Hz IMU stream
#define PRINT_INTERVAL_MS 1000

// ── Vibration motor ───────────────────────────────────────────────
#define MOTOR_PIN         4       // GPIO4 -> 1k -> 2N2222 base
#define VIBE_ON_MS        300     // pulse pattern while alerting
#define VIBE_OFF_MS       200
#define VIBE_TIMEOUT_MS   2500    // safety: off if the Pi goes quiet
#define CONNECT_BUZZ_MS   200     // short buzz when the Pi connects

// ── Calibration offsets ───────────────────────────────────────────
float offset_ax = 0, offset_ay = 0, offset_az = 0;
float offset_gx = 0, offset_gy = 0, offset_gz = 0;

// ── BLE state ─────────────────────────────────────────────────────
BLEServer*         pServer         = NULL;
BLECharacteristic* pCharacteristic = NULL;
BLECharacteristic* pVibeChar       = NULL;
bool deviceConnected    = false;
bool oldDeviceConnected = false;

// ── Vibration state (written from the BLE callback) ───────────────
volatile bool          vibeRequested = false;
volatile unsigned long lastVibeCmd   = 0;
unsigned long          buzzUntil     = 0;
bool                   buzzActive    = false;
bool                   motorOn       = false;

unsigned long lastSend  = 0;
unsigned long lastPrint = 0;


// ══════════════════════════════════════════════════════════════════
//  BLE callbacks
// ══════════════════════════════════════════════════════════════════
class ServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer* server) {
    deviceConnected = true;
    Serial.println("[BLE] Pi connected");
  }
  void onDisconnect(BLEServer* server) {
    deviceConnected = false;
    vibeRequested   = false;          // never keep buzzing without the Pi
    Serial.println("[BLE] Pi disconnected");
  }
};

class VibeCallbacks : public BLECharacteristicCallbacks {
  void onWrite(BLECharacteristic* c) {
    size_t   len  = c->getLength();
    uint8_t* data = c->getData();
    if (len >= 1) {
      vibeRequested = (data[0] != 0);
      lastVibeCmd   = millis();
    }
  }
};


// ══════════════════════════════════════════════════════════════════
//  BLE setup
// ══════════════════════════════════════════════════════════════════
void setupBLE() {
  BLEDevice::init(DEVICE_NAME);

  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  BLEService* pService = pServer->createService(SERVICE_UUID);

  // IMU data — headband to Pi
  pCharacteristic = pService->createCharacteristic(
      CHARACTERISTIC_UUID,
      BLECharacteristic::PROPERTY_READ |
      BLECharacteristic::PROPERTY_NOTIFY
  );
  pCharacteristic->addDescriptor(new BLE2902());   // lets the Pi subscribe

  // Vibration control — Pi to headband
  pVibeChar = pService->createCharacteristic(
      VIBE_UUID,
      BLECharacteristic::PROPERTY_WRITE |
      BLECharacteristic::PROPERTY_WRITE_NR
  );
  pVibeChar->setCallbacks(new VibeCallbacks());

  pService->start();

  BLEAdvertising* pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinPreferred(0x06);   // helps iPhone/Linux discovery
  pAdvertising->setMinPreferred(0x12);
  BLEDevice::startAdvertising();

  Serial.print("[BLE] Advertising as ");
  Serial.println(DEVICE_NAME);
}


// ══════════════════════════════════════════════════════════════════
//  Calibration
// ══════════════════════════════════════════════════════════════════
void calibrateMPU() {
  Serial.println("Calibrating MPU6050...");
  Serial.println("Keep sensor flat and still for 5 seconds!");
  delay(3000);

  float ax = 0, ay = 0, az = 0, gx = 0, gy = 0, gz = 0;
  int samples = 500;

  for (int i = 0; i < samples; i++) {
    sensors_event_t a, g, temp;
    mpu.getEvent(&a, &g, &temp);
    ax += a.acceleration.x;
    ay += a.acceleration.y;
    az += a.acceleration.z;
    gx += g.gyro.x;
    gy += g.gyro.y;
    gz += g.gyro.z;
    delay(5);
  }

  offset_ax = ax / samples;
  offset_ay = ay / samples;
  offset_az = (az / samples) - 9.81;   // subtract gravity from Z
  offset_gx = gx / samples;
  offset_gy = gy / samples;
  offset_gz = gz / samples;

  Serial.println("--- Calibration complete ---");
  Serial.print("Accel offsets X: "); Serial.print(offset_ax);
  Serial.print(" Y: ");              Serial.print(offset_ay);
  Serial.print(" Z: ");              Serial.println(offset_az);
  Serial.print("Gyro offsets  X: "); Serial.print(offset_gx);
  Serial.print(" Y: ");              Serial.print(offset_gy);
  Serial.print(" Z: ");              Serial.println(offset_gz);
  Serial.println("----------------------------");
}


// ══════════════════════════════════════════════════════════════════
//  Pack six calibrated floats into a 12-byte BLE payload
// ══════════════════════════════════════════════════════════════════
void sendIMU(float ax, float ay, float az,
             float gx, float gy, float gz) {

  if (!deviceConnected) return;

  int16_t packet[6];
  packet[0] = (int16_t) constrain(ax * ACCEL_SCALE, -32768, 32767);
  packet[1] = (int16_t) constrain(ay * ACCEL_SCALE, -32768, 32767);
  packet[2] = (int16_t) constrain(az * ACCEL_SCALE, -32768, 32767);
  packet[3] = (int16_t) constrain(gx * GYRO_SCALE,  -32768, 32767);
  packet[4] = (int16_t) constrain(gy * GYRO_SCALE,  -32768, 32767);
  packet[5] = (int16_t) constrain(gz * GYRO_SCALE,  -32768, 32767);

  pCharacteristic->setValue((uint8_t*) packet, sizeof(packet));
  pCharacteristic->notify();
}


// ══════════════════════════════════════════════════════════════════
//  Vibration motor — non-blocking, called every loop
// ══════════════════════════════════════════════════════════════════
void updateMotor(unsigned long now) {
  static bool          wasRequested = false;
  static unsigned long pulseStart   = 0;

  // Safety timeout — the Pi refreshes every second while alerting
  if (vibeRequested && now - lastVibeCmd > VIBE_TIMEOUT_MS) {
    vibeRequested = false;
    Serial.println("[VIBE] No command from Pi — motor off");
  }

  bool requested = vibeRequested;
  if (requested && !wasRequested) {
    pulseStart = now;                  // start the pattern on the "on" phase
    Serial.println("[VIBE] Alert — vibrating");
  }
  if (!requested && wasRequested) {
    Serial.println("[VIBE] Stopped");
  }
  wasRequested = requested;

  bool want = false;

  // Short buzz on connect so the wearer knows the link is up
  if (buzzActive) {
    if ((long)(buzzUntil - now) > 0) {
      want = true;
    } else {
      buzzActive = false;
    }
  }

  // Pulsed pattern while the Pi is alerting
  if (requested) {
    unsigned long phase = (now - pulseStart) % (VIBE_ON_MS + VIBE_OFF_MS);
    want = (phase < VIBE_ON_MS);
  }

  if (want != motorOn) {
    motorOn = want;
    digitalWrite(MOTOR_PIN, motorOn ? HIGH : LOW);
  }
}


// ══════════════════════════════════════════════════════════════════
//  Setup
// ══════════════════════════════════════════════════════════════════
void setup(void) {
  Serial.begin(115200);

  pinMode(MOTOR_PIN, OUTPUT);
  digitalWrite(MOTOR_PIN, LOW);

  Wire.begin(8, 9);              // SDA = GPIO8, SCL = GPIO9
  delay(1000);

  Serial.println("SleepAway Wearable Module");

  if (!mpu.begin()) {
    Serial.println("Failed to find MPU6050 chip");
    while (1) { delay(10); }
  }
  Serial.println("MPU6050 Found!");

  mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  mpu.setFilterBandwidth(MPU6050_BAND_10_HZ);   // reject road vibration

  Serial.println("Accelerometer: +/-8G");
  Serial.println("Gyroscope: +/-500 deg/s");
  Serial.println("DLPF: 10 Hz");

  calibrateMPU();
  setupBLE();

  Serial.println("Ready — streaming IMU over BLE");
  Serial.println("");
}


// ══════════════════════════════════════════════════════════════════
//  Main loop
// ══════════════════════════════════════════════════════════════════
void loop() {
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  // Apply calibration
  float cal_ax = a.acceleration.x - offset_ax;
  float cal_ay = a.acceleration.y - offset_ay;
  float cal_az = a.acceleration.z - offset_az;
  float cal_gx = g.gyro.x - offset_gx;
  float cal_gy = g.gyro.y - offset_gy;
  float cal_gz = g.gyro.z - offset_gz;

  unsigned long now = millis();

  // ── Transmit at SEND_INTERVAL_MS ────────────────────────────────
  if (now - lastSend >= SEND_INTERVAL_MS) {
    lastSend = now;
    sendIMU(cal_ax, cal_ay, cal_az, cal_gx, cal_gy, cal_gz);
  }

  // ── Motor ───────────────────────────────────────────────────────
  updateMotor(now);

  // ── Print to Serial far less often ──────────────────────────────
  if (now - lastPrint >= PRINT_INTERVAL_MS) {
    lastPrint = now;

    float pitch = atan2(cal_ax,
                  sqrt(cal_ay * cal_ay + cal_az * cal_az)) * 180.0 / PI;
    float roll  = atan2(cal_ay,
                  sqrt(cal_ax * cal_ax + cal_az * cal_az)) * 180.0 / PI;

    Serial.print(deviceConnected ? "[TX] " : "[--] ");
    Serial.print(vibeRequested ? "[VIBE] " : "");
    Serial.print("A: ");     Serial.print(cal_ax, 2);
    Serial.print(", ");      Serial.print(cal_ay, 2);
    Serial.print(", ");      Serial.print(cal_az, 2);
    Serial.print("  |  Pitch: "); Serial.print(pitch, 1);
    Serial.print("  Roll: ");     Serial.print(roll, 1);
    Serial.println(" deg");
  }

  // ── Connection changes ──────────────────────────────────────────
  if (deviceConnected && !oldDeviceConnected) {
    buzzUntil  = now + CONNECT_BUZZ_MS;   // short "connected" buzz
    buzzActive = true;
    oldDeviceConnected = deviceConnected;
  }
  if (!deviceConnected && oldDeviceConnected) {
    delay(500);                           // let the BLE stack settle
    pServer->startAdvertising();
    Serial.println("[BLE] Re-advertising");
    oldDeviceConnected = deviceConnected;
  }

  delay(5);   // small yield — keeps the BLE stack responsive
}
