#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Wire.h>

#include <BLEDevice.h>
#include <BLEServer.h>
#include <BLEUtils.h>
#include <BLE2902.h>

Adafruit_MPU6050 mpu;

// ── BLE identifiers — must match the Pi side exactly ──────────────
#define DEVICE_NAME         "SleepAway-Headband"
#define SERVICE_UUID        "4fafc201-1fb5-459e-8fcc-c5c9c331914b"
#define CHARACTERISTIC_UUID "beb5483e-36e1-4688-b7f5-ea07361b26a8"

// ── Scaling factors for int16 packing ─────────────────────────────
#define ACCEL_SCALE 400.0f
#define GYRO_SCALE  3000.0f

// ── Timing ────────────────────────────────────────────────────────
#define SEND_INTERVAL_MS  250     // 20 Hz BLE transmission
#define PRINT_INTERVAL_MS 1000   // 1 Hz serial printing

// ── Calibration offsets ───────────────────────────────────────────
float offset_ax = 0, offset_ay = 0, offset_az = 0;
float offset_gx = 0, offset_gy = 0, offset_gz = 0;

// ── BLE state ─────────────────────────────────────────────────────
BLEServer*         pServer         = NULL;
BLECharacteristic* pCharacteristic = NULL;
bool deviceConnected    = false;
bool oldDeviceConnected = false;

unsigned long lastSend  = 0;
unsigned long lastPrint = 0;


// ══════════════════════════════════════════════════════════════════
//  BLE connection callbacks
// ══════════════════════════════════════════════════════════════════
class ServerCallbacks : public BLEServerCallbacks {
  void onConnect(BLEServer* server) {
    deviceConnected = true;
    Serial.println("[BLE] Pi connected");
  }
  void onDisconnect(BLEServer* server) {
    deviceConnected = false;
    Serial.println("[BLE] Pi disconnected");
  }
};


// ══════════════════════════════════════════════════════════════════
//  BLE setup
// ══════════════════════════════════════════════════════════════════
void setupBLE() {
  BLEDevice::init(DEVICE_NAME);

  pServer = BLEDevice::createServer();
  pServer->setCallbacks(new ServerCallbacks());

  BLEService* pService = pServer->createService(SERVICE_UUID);

  pCharacteristic = pService->createCharacteristic(
      CHARACTERISTIC_UUID,
      BLECharacteristic::PROPERTY_READ |
      BLECharacteristic::PROPERTY_NOTIFY
  );

  pCharacteristic->addDescriptor(new BLE2902());
  pService->start();

  BLEAdvertising* pAdvertising = BLEDevice::getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->setScanResponse(true);
  pAdvertising->setMinPreferred(0x06);
  pAdvertising->setMinPreferred(0x12);
  BLEDevice::startAdvertising();

  Serial.print("[BLE] Advertising as ");
  Serial.println(DEVICE_NAME);
}


// ══════════════════════════════════════════════════════════════════
//  Calibration
// ══════════════════════════════════════════════════════════════════
void calibrateMPU() {
  Serial.println("Calibrating MPU6050...");
  Serial.println("Keep sensor flat and still for 5 seconds!");
  delay(3000);

  float ax = 0, ay = 0, az = 0, gx = 0, gy = 0, gz = 0;
  int samples = 500;

  for (int i = 0; i < samples; i++) {
    sensors_event_t a, g, temp;
    mpu.getEvent(&a, &g, &temp);
    ax += a.acceleration.x;
    ay += a.acceleration.y;
    az += a.acceleration.z;
    gx += g.gyro.x;
    gy += g.gyro.y;
    gz += g.gyro.z;
    delay(5);
  }

  offset_ax = ax / samples;
  offset_ay = ay / samples;
  offset_az = (az / samples) - 9.81;   // subtract gravity from Z
  offset_gx = gx / samples;
  offset_gy = gy / samples;
  offset_gz = gz / samples;

  Serial.println("--- Calibration complete ---");
  Serial.print("Accel offsets X: "); Serial.print(offset_ax);
  Serial.print(" Y: ");              Serial.print(offset_ay);
  Serial.print(" Z: ");              Serial.println(offset_az);
  Serial.print("Gyro offsets  X: "); Serial.print(offset_gx);
  Serial.print(" Y: ");              Serial.print(offset_gy);
  Serial.print(" Z: ");              Serial.println(offset_gz);
  Serial.println("----------------------------");
}


// ══════════════════════════════════════════════════════════════════
//  Pack six calibrated floats into a 12-byte BLE payload
// ══════════════════════════════════════════════════════════════════
void sendIMU(float ax, float ay, float az,
             float gx, float gy, float gz) {

  if (!deviceConnected) return;

  int16_t packet[6];
  packet[0] = (int16_t) constrain(ax * ACCEL_SCALE, -32768, 32767);
  packet[1] = (int16_t) constrain(ay * ACCEL_SCALE, -32768, 32767);
  packet[2] = (int16_t) constrain(az * ACCEL_SCALE, -32768, 32767);
  packet[3] = (int16_t) constrain(gx * GYRO_SCALE,  -32768, 32767);
  packet[4] = (int16_t) constrain(gy * GYRO_SCALE,  -32768, 32767);
  packet[5] = (int16_t) constrain(gz * GYRO_SCALE,  -32768, 32767);

  pCharacteristic->setValue((uint8_t*) packet, sizeof(packet));
  pCharacteristic->notify();
}


// ══════════════════════════════════════════════════════════════════
//  Setup
// ══════════════════════════════════════════════════════════════════
void setup(void) {
  Serial.begin(115200);
  Wire.begin(8, 9);              // SDA = GPIO8, SCL = GPIO9
  delay(1000);

  Serial.println("SleepAway Wearable Module");

  if (!mpu.begin()) {
    Serial.println("Failed to find MPU6050 chip");
    while (1) { delay(10); }
  }
  Serial.println("MPU6050 Found!");

  mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
  Serial.print("Accelerometer range set to: ");
  switch (mpu.getAccelerometerRange()) {
    case MPU6050_RANGE_2_G:  Serial.println("+-2G");  break;
    case MPU6050_RANGE_4_G:  Serial.println("+-4G");  break;
    case MPU6050_RANGE_8_G:  Serial.println("+-8G");  break;
    case MPU6050_RANGE_16_G: Serial.println("+-16G"); break;
  }

  mpu.setGyroRange(MPU6050_RANGE_500_DEG);
  Serial.print("Gyro range set to: ");
  switch (mpu.getGyroRange()) {
    case MPU6050_RANGE_250_DEG:  Serial.println("+- 250 deg/s");  break;
    case MPU6050_RANGE_500_DEG:  Serial.println("+- 500 deg/s");  break;
    case MPU6050_RANGE_1000_DEG: Serial.println("+- 1000 deg/s"); break;
    case MPU6050_RANGE_2000_DEG: Serial.println("+- 2000 deg/s"); break;
  }

  mpu.setFilterBandwidth(MPU6050_BAND_10_HZ);   // reject road vibration
  Serial.print("Filter bandwidth set to: ");
  switch (mpu.getFilterBandwidth()) {
    case MPU6050_BAND_260_HZ: Serial.println("260 Hz"); break;
    case MPU6050_BAND_184_HZ: Serial.println("184 Hz"); break;
    case MPU6050_BAND_94_HZ:  Serial.println("94 Hz");  break;
    case MPU6050_BAND_44_HZ:  Serial.println("44 Hz");  break;
    case MPU6050_BAND_21_HZ:  Serial.println("21 Hz");  break;
    case MPU6050_BAND_10_HZ:  Serial.println("10 Hz");  break;
    case MPU6050_BAND_5_HZ:   Serial.println("5 Hz");   break;
  }

  calibrateMPU();
  setupBLE();

  Serial.println("Ready — streaming IMU over BLE");
  Serial.println("");
}


// ══════════════════════════════════════════════════════════════════
//  Main loop
// ══════════════════════════════════════════════════════════════════
void loop() {
  sensors_event_t a, g, temp;
  mpu.getEvent(&a, &g, &temp);

  // Apply calibration offsets
  float cal_ax = a.acceleration.x - offset_ax;
  float cal_ay = a.acceleration.y - offset_ay;
  float cal_az = a.acceleration.z - offset_az;
  float cal_gx = g.gyro.x - offset_gx;
  float cal_gy = g.gyro.y - offset_gy;
  float cal_gz = g.gyro.z - offset_gz;

  unsigned long now = millis();

  // ── Transmit over BLE at 20 Hz ──────────────────────────────────
  if (now - lastSend >= SEND_INTERVAL_MS) {
    lastSend = now;
    sendIMU(cal_ax, cal_ay, cal_az, cal_gx, cal_gy, cal_gz);
  }

  // ── Print to Serial at 1 Hz ─────────────────────────────────────
  if (now - lastPrint >= PRINT_INTERVAL_MS) {
    lastPrint = now;

    float pitch = atan2(cal_ax,
                  sqrt(cal_ay * cal_ay + cal_az * cal_az)) * 180.0 / PI;
    float roll  = atan2(cal_ay,
                  sqrt(cal_ax * cal_ax + cal_az * cal_az)) * 180.0 / PI;

    Serial.print(deviceConnected ? "[TX] " : "[--] ");
    Serial.print("Accel X: "); Serial.print(cal_ax, 2);
    Serial.print(", Y: ");     Serial.print(cal_ay, 2);
    Serial.print(", Z: ");     Serial.print(cal_az, 2);
    Serial.print(" m/s^2  |  Roll: "); Serial.print(roll, 1);
    Serial.print(", Pitch: ");         Serial.print(pitch, 1);
    Serial.println(" deg");
  }

  // ── Restart advertising after a disconnect ──────────────────────
  if (!deviceConnected && oldDeviceConnected) {
    delay(500);
    pServer->startAdvertising();
    Serial.println("[BLE] Re-advertising");
    oldDeviceConnected = deviceConnected;
  }
  if (deviceConnected && !oldDeviceConnected) {
    oldDeviceConnected = deviceConnected;  
  }

  delay(5);   // small yield — keeps the BLE stack responsive
}
